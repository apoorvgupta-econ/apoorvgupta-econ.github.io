@unpublished{eaglin2026working,
  bibtex_show={true},
  category={working_paper},
  selected={true},
  title={Working it out: Randomized Modification and Entrepreneurial Effort in a Collateralized Debt Market},
  author={Eaglin, Christopher and Gupta, Apoorv and Mezzanotti, Filippo and Zinman, Jonathan},
  year={2026},
  month={September},
  pdf={Workouts_EGMZ.pdf},
  pre_registry={https://www.socialscienceregistry.org/trials/13052},
  abstract={We conduct a collateralized debt modification experiment on a large lender's nonperforming loans to minibus entrepreneurs, guiding its design and interpretation by adding liquidity constraints to a standard debt contracting model with strategic incentives. Liquidity constraints add another borrower incentive compatibility constraint that interacts with strategic motives to shape repayment and effort. The model predicts specific conditions under which different contracting approaches will be (in)effective at changing borrower behavior, collateral actually worsens incentive alignment, and borrower repayment and effort responses will diverge. Empirical results are consistent with model predictions and suggest a pecking order strategy for modification practice and policy.}
}

@unpublished{crouzet2026demographics,
  bibtex_show={true},
  category={working_paper},
  selected={false},
  title={Demographics and Technology Diffusion: Evidence from Mobile Payments},
  author={Crouzet, Nicolas and Ghosh, Pulak and Gupta, Apoorv and Mezzanotti, Filippo},
  year={2026},
  month={February},
  pdf={Demographics_live.pdf},
  ssrn={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=4778382},
  coverage={[Kellogg Insights](https://insight.kellogg.northwestern.edu/article/swipe-or-tap-how-age-shapes-the-adoption-of-new-technologies)},
  abstract={We show that the age composition of the population can shape the speed at which businesses adopt new technologies, using evidence from mobile payments in India. Consumers' propensity to use new payment technologies declines with age, creating stronger incentives for businesses serving younger customers to accept these technologies. We document this pattern in the rollout of a mobile payment option by a major fintech company. A model where consumer attitudes toward technology vary by age implies that business adoption is inefficiently low, with the young bearing disproportionate welfare losses from network externalities. Jointly subsidizing transaction and adoption costs restores efficiency.}
}

@unpublished{ghosh2025information,
  bibtex_show={true},
  category={working_paper},
  selected={false},
  title={Information Frictions and Take-up of Government Credit Programs},
  author={Ghosh, Pulak and Gupta, Apoorv and Ponticelli, Jacopo and Tesei, Andrea},
  year={2025},
  month={December},
  rr={Economic Journal},
  pdf={InfoFrictionsCreditTakeup.pdf},
  abstract={Governments in most developing countries offer subsidized credit programs to the agricultural sector, yet farmers often lack information on these programs. We study the impact of information frictions on credit take-up by exploiting the construction of mobile phone towers in previously unconnected areas of India. Areas receiving towers experience an increase in farmers' calls to call-centers for agricultural advice and higher take-up of agricultural loans. Loan uptake rises particularly for government credit programs that farmers inquire about. New loans are mostly used for consumption in times of adverse weather shocks. Higher credit participation does not lead to higher default rates.}
}

@unpublished{gupta2024markups,
  bibtex_show={true},
  category={working_paper},
  selected={true},
  title={Demand for Quality, Variable Markups and (Mis)allocation: Evidence from India},
  author={Gupta, Apoorv},
  year={2024},
  month={March},
  rr={American Economic Journal: Applied Economics},
  pdf={MarkupsMisallocationIndia.pdf},
  ssrn={https://papers.ssrn.com/sol3/papers.cfm?abstract_id=3685273},
  abstract={Markups vary systematically across firms and generate misallocation, yet empirical evidence on sources driving markup variation is limited. I study how demand-side factors affect markups. Using detailed firm-product-level data from India, I document that both marginal costs and markups are increasing in firm size. Changes in markups across the firm-size distribution in response to exogenous demand shocks to poor households lend support to the demand-based markup channel: producing better quality and selling to wealthier, less demand-elastic households leads larger firms to incur higher costs and charge higher markups. Accounting for the demand-based channel reduces estimated misallocation losses by 30 percent.}
}

@article{gupta2026language,
  bibtex_show={true},
  category={publication},
  selected={true},
  title={Language Barriers, Technology Adoption and Productivity: Evidence from Agriculture in India},
  author={Gupta, Apoorv and Ponticelli, Jacopo and Tesei, Andrea},
  journal={Review of Economics and Statistics},
  year={2026},
  month={January},
  doi={10.1162/rest_a_01501},
  pdf={LanguageTechAdoption_live.pdf},
  coverage={[VoxDev](https://voxdev.org/topic/agriculture/do-language-barriers-hold-back-agricultural-development) · [World Bank Development Blog](https://blogs.worldbank.org/impactevaluations/difference-differences-practice-case-mobile-phones-and-farmers-productivity) · [Ideas for India](https://www.ideasforindia.in/topics/agriculture/information-technology-adoption-and-productivity-role-of-mobile-phones-in-indian-agriculture.html) · [Kellogg Insights](https://insight.kellogg.northwestern.edu/article/advice-hotline-farmers-india) · [ThePrint](https://theprint.in/opinion/farmers-adopt-advanced-tech-raise-productivity-when-they-have-mobile-phones-study/563867/)},
  abstract={We study the effect of language barriers on the ability of farmers to access information about agricultural technologies in rural areas of India. We use the introduction of government-sponsored call centers (Kisan Call Centers) which offer agricultural advice in the official language of each Indian state. For identification, we compare geographically contiguous areas that sit across state borders, and exploit differences in the language spoken by farmers and call center advisors. We document that language barriers limit the adoption of modern agricultural technologies — such as high-yielding variety seeds — and negatively affect crop yields.}
}

@article{crouzet2023shocks,
  bibtex_show={true},
  category={publication},
  selected={true},
  title={Shocks and Technology Adoption: Evidence from Electronic Payment Systems},
  author={Crouzet, Nicolas and Gupta, Apoorv and Mezzanotti, Filippo},
  journal={Journal of Political Economy},
  volume={131},
  number={11},
  pages={3003--3065},
  year={2023},
  month={November},
  doi={10.1086/724847},
  pdf={ShocksTechAdoption_live.pdf},
  replication={https://doi.org/10.7910/DVN/ZB45FV},
  data={https://drive.google.com/file/d/1YPXGMu02yzMNTH3g423J7VK8GuirVjXm/view?usp=share_link},
  coverage={[Kellogg Insights](https://insight.kellogg.northwestern.edu/article/fintech-growth-policy) · [ARK Invest](https://ark-invest.com/podcast/analyzing-indias-digital-wallet-adoption-after-demonetization-with-nicolas-crouzet-and-filippo-mezzanotti/) · [CNBC](https://www.cnbc.com/2020/03/16/electronic-payments-look-more-appealing-as-coronavirus-spreads.html) · [TPRI](http://sites.bu.edu/tpri/2019/03/11/shocks-and-technology-adoption-evidence-from-electronic-payment-systems/) · [QRIUS](https://qrius.com/demonetization-could-have-spurred-the-shift-to-e-payments-in-india/) · [LSE Business Review](https://blogs.lse.ac.uk/businessreview/2023/09/14/why-isnt-the-adoption-of-digital-wallets-moving-faster/) · [Visible Hand Podcast](https://www.thevisiblehand.uk/episodes/episode-70)},
  abstract={We provide evidence on the importance of coordination frictions in technology adoption, using data from a large provider of electronic wallets during the Indian demonetization. Exploiting geographical variation in exposure to the demonetization, we show that adoption of the wallet increased persistently in response to the large but temporary cash contraction, consistent with the predictions of a technology adoption model with complementarities. Model estimates indicate that adoption would have been 45% lower without complementarities. Our results illustrate how large but temporary interventions can help overcome coordination frictions, though we caution that such interventions may also exacerbate initial differences in adoption.}
}
